# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# sqlite (rebuilt from src/db/seed-data.ts on first request)
/data/

# test output (regenerated by `npm run test:coverage`)
/coverage/

# graphify skill output (regenerated by the graphify skill)
/graphify-out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# agent settings — settings.local.json holds a live auth token
.claude/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
